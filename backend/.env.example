# ==========================================
# Nankwanya Backend Environment Configuration
# ==========================================

PORT=5000

# Africa's Talking API (Uganda)
# Use 'sandbox' for testing or your live Africa's Talking username
AT_USERNAME=sandbox
AT_API_KEY=YOUR_AFRICAS_TALKING_API_KEY
# Optional alphanumeric Sender ID (requires Africa's Talking approval for live SMS)
AT_SENDER_ID=

# Firebase Configuration (Optional - runs in resilient local store mode if unconfigured)
FIREBASE_PROJECT_ID=
# Paste single-line JSON string of serviceAccountKey.json if using service account
FIREBASE_SERVICE_ACCOUNT_KEY=
