# ==========================================
# Nankwanya Backend Environment Configuration
# ==========================================

PORT=5000

# Pandora SMS API (Uganda)
PANDORA_API_URL=https://www.sms.thepandoranetworks.com/API/send_sms/
PANDORA_USERNAME=
PANDORA_PASSWORD=
PANDORA_SENDER_ID=Nankwanya
PANDORA_MESSAGE_TYPE=non_customised
PANDORA_MESSAGE_CATEGORY=bulk
NANKWANYA_CONFIRM_PHONE=0800 122 422

# Firebase Configuration (Optional - runs in resilient local store mode if unconfigured)
FIREBASE_PROJECT_ID=
# Paste single-line JSON string of serviceAccountKey.json if using service account
FIREBASE_SERVICE_ACCOUNT_KEY=
