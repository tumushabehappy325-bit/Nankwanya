{
  "name": "nankwanya",
  "version": "1.0.0",
  "description": "Nankwanya - Geofencing-Based Blood Donation Mobilization Platform for Uganda",
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"red,cyan\" \"npm --prefix backend run dev\" \"npm --prefix frontend run dev\"",
    "start": "node backend/src/server.js",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "seed": "node seed/seedData.js",
    "build": "npm --prefix frontend run build",
    "test": "node backend/test_backend.js"
  },
  "dependencies": {
    "africastalking": "^0.6.2",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "firebase-admin": "^12.0.0",
    "morgan": "^1.10.0"
  },
  "keywords": ["blood-donation", "geofencing", "uganda", "africastalking", "firebase", "vercel"],
  "author": "Nankwanya Platform",
  "license": "MIT"
}
